# ============================================================
# ranking_msc — Configuração principal
# ============================================================
# Copie este arquivo para config/settings.yaml e ajuste.
# Não commite o settings.yaml real (ele está no .gitignore).

app:
  title: "Ranking MSC — Validação Contábil"
  debug: false
  esfera: "municipal"                 # esfera do ente: "municipal", "estadual" ou "federal"

paths:
  data_dir: "./data"
  snapshots_dir: "./data/snapshots"
  reports_dir: "./data/reports"
  logs_dir: "./data/logs"
  ref_dir: "./ref"                    # tabelas de referência (PCASP, domínios)
  uso_dir: "./data/uso"               # tempo de uso por usuário (JSONL mensal)

rules:
  # 78 regras habilitadas — motor completo (Fase 4 concluída)
  enabled:
    - "R001"
    - "R0010"
    - "R0011"
    - "R002"
    - "R003"
    - "R004"
    - "R005"
    - "R006"
    - "R007"
    - "R008"
    - "R009"
    - "R010"
    - "R011"
    - "R012"
    - "R020"
    - "R021"
    - "R022"
    - "R023"
    - "R024"
    - "R025"
    - "R026"
    - "R027"
    - "R028"
    - "R029"
    - "R030"
    - "R031"
    - "R032"
    - "R033"
    - "R034"
    - "R035"
    - "R036"
    - "R037"
    - "R038"
    - "R039"
    - "R040"
    - "R041"
    - "R042"
    - "R043"
    - "R044"
    - "R045"
    - "R046"
    - "R047"
    - "R048"
    - "R050"
    - "R051"
    - "R052"
    - "R053"
    - "R054"
    - "R055"
    - "R060"
    - "R061"
    - "R062"
    - "R063"
    - "R064"
    - "R065"
    - "R066"
    - "R067"
    - "R068"
    - "R069"
    - "R070"
    - "R071"
    - "R072"
    - "R073"
    - "R074"
    - "R080"
    - "R081"
    - "R082"
    - "R083"
    - "R084"
    - "R085"
    - "R086"
    - "R087"
    - "R088"
    - "R089"
    - "R090"
    - "R091"
    - "R092"
    - "R093"
  fail_fast: false                    # true = para ao primeiro ERRO

security:
  # JWT — gere a chave com: openssl rand -hex 32
  secret_key: "change-me-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 480    # 8 horas

  # Usuários cadastrados. Sem usuários e com secret_key padrão o sistema sobe
  # em modo não configurado (nenhum login possível) — configure os DOIS juntos:
  # um secret_key real (openssl rand -hex 32) E ao menos um usuário.
  # Gere o hash com:
  #   python -c "import bcrypt; print(bcrypt.hashpw(b'sua-senha', bcrypt.gensalt()).decode())"
  # users:
  #   - username: "admin"
  #     hashed_password: "$2b$12$SUBSTITUA_PELO_HASH_REAL"

siconfi:
  id_ente: 2507507              # codigo IBGE do ente (Joao Pessoa - PB)
  cache_ttl_horas: 24
  # Prazo em dias apos o fim do periodo. Entregavel ausente deste mapa aparece
  # na tela apenas com o dado factual (dias decorridos), SEM veredicto de
  # atraso -- preferimos nao julgar a julgar errado.
  # Fundamentados: RREO e RGF (LRF arts. 52 e 55 par. 2o).
  # DCA e MSC ficam DE FORA ate a contabilidade confirmar os prazos.
  prazos_dias:
    "Relatório Resumido de Execução Orçamentária": 30
    "Relatório de Gestão Fiscal": 30
