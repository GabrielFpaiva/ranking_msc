# ============================================================
# ranking_msc — Configuração principal
# ============================================================
# Copie este arquivo para config/settings.yaml e ajuste.
# Não commite o settings.yaml real (ele está no .gitignore).

app:
  title: "Ranking MSC — Validação Contábil"
  debug: false

paths:
  data_dir: "./data"
  snapshots_dir: "./data/snapshots"
  reports_dir: "./data/reports"
  logs_dir: "./data/logs"
  ref_dir: "./ref"                    # tabelas de referência (PCASP, domínios)

rules:
  # Lista de regras habilitadas. Adicione/remova conforme necessário.
  enabled:
    - "R001"
    - "R002"
    - "R003"
    - "R004"
    - "R005"
    - "R010"
    - "R011"
    - "R012"
    - "R020"
    - "R021"
    - "R022"
    - "R023"
    - "R024"
    - "R025"
    - "R026"
    - "R030"
    - "R080"
    - "R081"
    # R082-R111: a implementar nas próximas sprints
  fail_fast: false                    # true = para ao primeiro ERRO

security:
  max_concurrent_jobs: 3              # máximo de processamentos simultâneos
  allowed_users: []                   # vazio = todos; ou lista de logins
