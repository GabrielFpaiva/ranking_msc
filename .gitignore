# Config real (só o .example vai pro repo)
config/settings.yaml

# Estado local do convite assinado (segredo ou dado de quem convida): fora do desktop a
# pasta de estado é config/, e um `git add config/` levaria a senha de app cifrada.
# Só config/invites.yaml (chave pública, sem segredo) é versionado.
config/invite_key.pem
config/invite_issuer.yaml
config/invites_sent.jsonl
config/invites_used.json
# Temporários das gravações atômicas (`.<nome>.tmp`, trocados por os.replace): uma queda no
# meio deixaria a sobra do segredo (ou do invites.yaml) à vista do `git add config/`.
config/.invite_*.tmp
config/.invites_*.tmp
config/.invites.yaml.tmp

# Git worktrees
.worktrees/

# Gravacao do video de demonstracao (scripts/demo_video/)
