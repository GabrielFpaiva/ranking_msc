# Exclui arquivos binários e de dados das estatísticas de linguagem do GitHub Linguist.
# Sem isso, os .xlsx (ZIP de XML) aparecem como "HTML" e distorcem o gráfico de linguagens.

*.xlsx linguist-vendored
*.pdf  linguist-vendored
*.csv  linguist-vendored

ref/amostras/* linguist-vendored

# Shell scripts e entrypoints precisam de LF mesmo em checkouts Windows,
# senão `/bin/sh` no container falha com "no such file or directory".
*.sh text eol=lf
docker/entrypoint.sh text eol=lf
